  "buildModes": {
    "single": {
      "title": "单表查询",
      "description": "基于一个数据集/表生成标准 API，配置最少，上手最快。",
      "badges": {
        "fast": "快速上手",
        "crud": "适配 CRUD"
      }
    },
    "join": {
      "title": "多表关联",
      "description": "关联多个相关表，对外提供统一的 API 返回结构。",
      "badges": {}
    },
