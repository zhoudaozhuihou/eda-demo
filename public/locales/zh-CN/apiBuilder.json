      "title": "注入点模式",
      "description": "在保证参数安全的前提下，提供受控注入点以支持动态条件。",
      "badges": {
        "dynamic": "动态过滤",
        "parameterized": "参数化"
      },
      "steps": {
        "2": {
          "name": "配置注入点",
          "desc": "设置SQL注入点的位置和参数"
        },
        "3": {
          "name": "编写查询SQL",
          "desc": "编写包含注入点的SELECT查询"
        }
      }
