  "steps": {
    "1": {
      "name": "选择构建模式",
      "desc": "选择 API 的生成方式"
    },
    "2": {
      "name": "配置数据源",
      "desc": "选择主数据集"
    },
    "3": {
      "name": "定义参数",
      "desc": "选择请求参数与返回字段"
    },
    "apiConfig": {
      "name": "API 配置",
      "desc": "请求参数、返回结构与 Mock"
    },
    "4": {
      "name": "编写 SQL",
      "desc": "生成、校验并优化查询逻辑"
    },
    "5": {
      "name": "发布",
      "desc": "配置API名称、方法、鉴权与限流并发布"
    }
  },
  "buildMode": {
    "title": "选择构建模式"
