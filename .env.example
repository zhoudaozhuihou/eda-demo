# Example Configuration File
# Copy this file to .env.local or specific environment file (e.g., .env.development)

# Application Name
VITE_APP_NAME="API Platform"

# API Base URL
VITE_API_BASE_URL="http://localhost:3000/api"

# Default Language
VITE_DEFAULT_LOCALE="zh-CN"

# Feature Flags
VITE_ENABLE_MOCK="true"
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_DEV_TOOLS="true"

# Third-party Keys
VITE_SENTRY_DSN=""
